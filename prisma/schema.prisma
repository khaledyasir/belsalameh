// Balsalameh platform — data model (Microsoft SQL Server)
// ---------------------------------------------------------------------------
// Apply with:   npx prisma db push        (or: npx prisma migrate deploy)
// Inspect in SSMS: db/mssql-schema.sql is the hand-written equivalent DDL.
//
// SQL Server has no enum type, so "enum" columns are NVARCHAR with a CHECK
// constraint (see the .sql file); allowed values are listed next to each field.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Staff accounts for the admin console. Buyers never authenticate.
model AdminUser {
  id           String    @id @default(cuid()) @db.NVarChar(30)
  username     String     @unique @db.NVarChar(50)
  email        String     @unique @db.NVarChar(256)
  name         String     @db.NVarChar(120)
  passwordHash String     @db.NVarChar(256)
  passwordSalt String     @db.NVarChar(64)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs AuditLog[]

  @@map("AdminUsers")
}

/// One row per subscriber. The website spec permits storing only:
/// full name, email, Membership ID, expiry month + year. The remaining
/// columns are operational links, kept separate in the UI.
model Member {
  id           String   @id @default(cuid()) @db.NVarChar(30)
  membershipId String   @unique @db.NVarChar(20) // BSL-XXXX-XXXX
  fullName     String   @db.NVarChar(120)
  email        String   @db.NVarChar(256)
  expiryMonth  Int // 1-12
  expiryYear   Int
  status       String   @default("ACTIVE") @db.NVarChar(20) // ACTIVE | EXPIRED | REVOKED
  purchasedAt  DateTime
  expiryEmailSentAt DateTime? // set once the "your membership has ended" email went out
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactionId String?      @db.NVarChar(30) // one payment can cover several people
  emails        EmailLog[]

  @@index([email])
  @@index([status])
  @@index([transactionId])
  @@map("Members")
}

/// A payment attempt. Created PENDING at checkout; moved to CAPTURED by the
/// payment-confirmation path (manual now, MEPS webhook in Phase 3).
model Transaction {
  id                     String    @id @default(cuid()) @db.NVarChar(30)
  reference              String    @unique @db.NVarChar(40) // our order reference
  provider               String    @default("MEPS") @db.NVarChar(20)
  providerRef            String?   @db.NVarChar(100) // gateway transaction id
  amountMinor            Int
  currency               String    @default("JOD") @db.NVarChar(3)
  durationMonths         Int       @default(12) // membership length agreed at checkout (per person)
  status                 String    @default("PENDING") @db.NVarChar(20) // PENDING | CAPTURED | FAILED | REFUNDED
  fullName               String    @db.NVarChar(120)
  email                  String    @db.NVarChar(256)
  consentTermsAccepted   Boolean   @default(false)
  consentPrivacyAccepted Boolean   @default(false)
  consentVersion         String?   @db.NVarChar(20)
  consentAdultConfirmed  Boolean   @default(false) // payer confirmed everyone on the order is 18+
  party                  String?   @db.NVarChar(Max) // JSON [{fullName, email?}] — extra people on this order
  failureReason          String?   @db.NVarChar(400)
  rawResponse            String?   @db.NVarChar(Max) // gateway payload (JSON text)
  ipnReceivedAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  members Member[]

  @@index([status])
  @@index([createdAt])
  @@map("Transactions")
}

/// The plan being sold right now — a single row (id "default") edited in Admin › Settings.
/// The public site, checkout and the walk-in tab all read it. Existing members are unaffected.
model MembershipSettings {
  id              String   @id @default("default") @db.NVarChar(20)
  priceMinor      Int // total price for `durationMonths`, per person, in minor units (JOD: 1000 = 1.000)
  durationMonths  Int
  sendExpiryEmail Boolean  @default(true) // email members when their membership ends, with a link to renew
  updatedAt       DateTime @updatedAt

  @@map("MembershipSettings")
}

/// Inbound payment notifications (MEPS IPN). Dedupe key makes processing
/// idempotent. Ready for Phase 3.
model WebhookEvent {
  id             String    @id @default(cuid()) @db.NVarChar(30)
  provider       String    @default("MEPS") @db.NVarChar(20)
  dedupeKey      String    @unique @db.NVarChar(200)
  signatureValid Boolean   @default(false)
  payload        String    @db.NVarChar(Max)
  result         String?   @db.NVarChar(20) // ok | ignored | error
  error          String?   @db.NVarChar(400)
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
  @@map("WebhookEvents")
}

/// Delivery log for the Proof of Membership email (and future system mail).
model EmailLog {
  id                String   @id @default(cuid()) @db.NVarChar(30)
  type              String   @db.NVarChar(40) // proof_of_membership
  toAddress         String   @db.NVarChar(256)
  subject           String   @db.NVarChar(200)
  status            String   @default("queued") @db.NVarChar(20) // queued | sent | delivered | bounced | failed
  providerMessageId String?  @db.NVarChar(120)
  error             String?  @db.NVarChar(400)
  createdAt         DateTime @default(now())

  member   Member? @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberId String? @db.NVarChar(30)

  @@index([status])
  @@map("EmailLogs")
}

/// Every mutating admin action.
model AuditLog {
  id        String   @id @default(cuid()) @db.NVarChar(30)
  action    String   @db.NVarChar(60)
  entity    String   @db.NVarChar(40)
  entityId  String   @db.NVarChar(60)
  detail    String?  @db.NVarChar(Max)
  createdAt DateTime @default(now())

  actor   AdminUser? @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorId String?    @db.NVarChar(30)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("AuditLogs")
}
