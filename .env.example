# ─────────────────────────────────────────────────────────────────────────────
# Balsalameh platform — environment template
# Copy to `.env` for local development. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# Feature flags
PUBLIC_SITE_ENABLED="false"   # true = drop the preview ribbon + noindex
PAYMENTS_LIVE="false"         # true once MEPS is wired (hides the manual confirm button)

# ── Database — Microsoft SQL Server ─────────────────────────────────────────
# Prisma connection string. Example for a local instance:
DATABASE_URL="sqlserver://localhost:1433;database=balsalameh;user=sa;password=Your_Strong_Pass1;encrypt=true;trustServerCertificate=true"
# Named instance / Windows auth example:
# DATABASE_URL="sqlserver://localhost;database=balsalameh;integratedSecurity=true;trustServerCertificate=true"
#
# Setup:
#   npm run prisma:generate
#   npm run db:push          # creates the tables (or run db/mssql-schema.sql in SSMS)
#   npm run db:seed          # creates the first admin from the ADMIN_* vars below

# ── First admin account (seeded once, then managed in Admin › My profile) ──
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"
AUTH_SESSION_TTL_MINUTES="45"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin1234"
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@balsalameh.example"

# ── Payment gateway — MEPS (Phase 3) ──────────────────────────────────────
# Set MEPS_MODE to enable the webhook route. Values come from the MEPS manual.
# MEPS_MODE="TEST"                 # TEST | LIVE
# MEPS_MERCHANT_ID=""
# MEPS_API_BASE=""
# MEPS_SECRET=""                   # request-signing secret; use a secret manager
# MEPS_RETURN_URL="${NEXT_PUBLIC_SITE_URL}/checkout/processing"
# MEPS_WEBHOOK_PATH="/api/webhooks/meps"

# ── Transactional email (Phase 3) ────────────────────────────────────────
# EMAIL_PROVIDER=""                # resend | postmark | ses
# EMAIL_API_KEY=""
# EMAIL_FROM="Balsalameh <membership@example.com>"

# Observability (recommended before Phase 3)
# SENTRY_DSN=""
