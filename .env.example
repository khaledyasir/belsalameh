# ─────────────────────────────────────────────────────────────────────────────
# Balsalameh platform — environment template
# Copy to `.env` for local development. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# Feature flags (Phase strategy — see README)
PUBLIC_SITE_ENABLED="false"
PAYMENTS_LIVE="false"
EMAILS_ENABLED="false"

# ── Admin login (Phase 1) ───────────────────────────────────────────────────
# A single admin account. On first run these seed `.data/admin.json`; after
# that, the name / email / password are managed from Admin › My profile.
# Phase 3 replaces this with Auth.js + a hashed credential in the database.
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"
AUTH_SESSION_TTL_MINUTES="45"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin1234"
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@balsalameh.example"

# Database (Phase 1 admin runs on mock data without this; needed from Phase 3)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/balsalameh?schema=public"

# Payment gateway — MEPS (Phase 3). Values come from the official MEPS manual.
# MEPS_MODE="TEST"                # TEST | LIVE
# MEPS_MERCHANT_ID=""
# MEPS_API_BASE=""
# MEPS_SECRET=""                  # request-signing secret; store in a secret manager
# MEPS_RETURN_URL="${NEXT_PUBLIC_SITE_URL}/checkout/return"
# MEPS_WEBHOOK_PATH="/api/webhooks/meps"

# Transactional email (Phase 3). Provider TBD — Resend / Postmark / SES.
# EMAIL_PROVIDER=""
# EMAIL_API_KEY=""
# EMAIL_FROM="Balsalameh <membership@example.com>"   # PLACEHOLDER sending address

# Observability (recommended before Phase 3)
# SENTRY_DSN=""
