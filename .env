# ─────────────────────────────────────────────────────────────────────────────
# Belsalameh platform — environment
# Committed for convenience (private repo). Values here are LOCAL DEV defaults.
# On a real server, override the marked lines (DATABASE_URL, AUTH_SECRET,
# SENDGRID_API_KEY, NEXT_PUBLIC_SITE_URL, the flags).
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"     # SERVER: set to the real https URL (baked in at build time)

# Feature flags
PUBLIC_SITE_ENABLED="false"                      # SERVER: "true"
PAYMENTS_LIVE="false"                            # "true" only once MEPS is wired
EMAILS_ENABLED="true"
ALLOW_SIMULATED_PAYMENT="true"                   # SERVER: "false" — dev-only "record payment" button

# ── Admin login ────────────────────────────────────────────────────────────
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"   # SERVER: 48+ random chars, or the app refuses to boot in production
AUTH_SESSION_TTL_MINUTES="45"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin1234"                       # SERVER: set a real password before `npm run setup`
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@belsalameh.com"

# ── Database — Microsoft SQL Server ────────────────────────────────────────
DATABASE_URL="sqlserver://localhost:1433;database=balsalameh_dev;user=bsl_app;password=Bsl_Dev_Pass123;encrypt=true;trustServerCertificate=true"
# SERVER example:
# DATABASE_URL="sqlserver://SQLHOST:1433;database=belsalameh;user=bsl_app;password=...;encrypt=true;trustServerCertificate=true"

# ── Payment gateway — MEPS (not wired yet) ─────────────────────────────────
# MEPS_MODE="TEST"
# MEPS_MERCHANT_ID=""
# MEPS_API_BASE=""
# MEPS_SECRET=""
# MEPS_RETURN_URL="${NEXT_PUBLIC_SITE_URL}/checkout/return"
# MEPS_WEBHOOK_PATH="/api/webhooks/meps"

# ── Transactional email — SendGrid HTTP API ───────────────────────────────
# Sends only when EMAILS_ENABLED=true AND a key is set.
SENDGRID_API_KEY=""                              # SERVER: paste the key (starts "SG."); keep it out of git going forward
EMAIL_FROM="Belsalameh <support@belsalameh.com>"   # must be a SendGrid-verified sender/domain
EMAIL_COMPANY_NOTIFY="support@belsalameh.com"      # internal copy for every captured payment
